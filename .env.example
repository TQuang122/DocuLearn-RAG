# Required for Q&A and learning generation. Never commit a real key.
GEMINI_API_KEY=

# Optional API protection. Clients then send the X-API-Key header.
RAG_API_KEY=

# Optional Gradio basic authentication; configure both or neither.
RAG_GRADIO_USERNAME=
RAG_GRADIO_PASSWORD=

# Runtime paths and limits.
RAG_DATA_DIR=data
RAG_STORAGE_DIR=storage/qdrant
RAG_EXPORT_DIR=exports
RAG_MAX_UPLOAD_BYTES=26214400
RAG_SERVER_NAME=127.0.0.1
RAG_SERVER_PORT=7860
