# Required for Q&A and learning generation. Never commit a real key.
GEMINI_API_KEY=

# Optional API protection. Clients then send the X-API-Key header.
RAG_API_KEY=

# Optional Gradio basic authentication; configure both or neither.
RAG_GRADIO_USERNAME=
RAG_GRADIO_PASSWORD=

# Runtime paths and limits.
RAG_DATA_DIR=data
RAG_STORAGE_DIR=storage/qdrant
RAG_EXPORT_DIR=exports
RAG_MAX_UPLOAD_BYTES=26214400
RAG_SERVER_NAME=127.0.0.1
RAG_SERVER_PORT=7860

# Guarded fusion retrieval pilot. Dense remains the safe default.
RAG_RETRIEVAL_MODE=dense
RAG_RETRIEVAL_CANDIDATE_K=50
RAG_RETRIEVAL_DENSE_WEIGHT=0.25
RAG_RETRIEVAL_MAX_CHUNKS_PER_PAGE=1
RAG_RETRIEVAL_FALLBACK_TO_DENSE=true
RAG_RETRIEVAL_TELEMETRY_ENABLED=false
RAG_RETRIEVAL_SHADOW_SAMPLE_RATE=0.0
RAG_RETRIEVAL_TELEMETRY_MAX_BYTES=5242880
RAG_RETRIEVAL_TELEMETRY_RETAINED_EVENTS=5000
RAG_EMBEDDING_WARMUP_ENABLED=false
